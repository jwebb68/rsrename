{
	"version": "2.0.0",
        "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": false,
                "clear": false
        },
        "tasks": [
                {
                        "type": "process",
                        "command":"nix",
                        "args": [
                                "develop",
                                "--command",
                                "cargo",
                                "build"
                        ],
                        "problemMatcher": [
                                "$rustc"
                        ],
                        "group": "build",
                        "label": "Rust: cargo build debug"
                },
                {
                        "type": "process",
                        "command":"nix",
                        "args": [
                                "develop",
                                "--command",
                                "cargo",
                                "check"
                        ],
                        "problemMatcher": [
                                "$rustc"
                        ],
                        "group": "build",
                        "label": "Rust: cargo check"
                },
                {
                        "type": "process",
                        "command":"nix",
                        "args": [
                                "develop",
                                "--command",
                                "cargo",
                                "test"
                        ],
                        "problemMatcher": [
                                "$rustc"
                        ],
                        "group": "test",
                        "label": "Rust: cargo test"
                },
                {
                        "label": "Rust: cargo criterion",
                        "type": "process",
                        "command":"nix",
                        "args": [
                                "develop",
                                "--command",
                                "cargo",
                                "criterion"
                        ],
                        "problemMatcher": [
                                "$rustc"
                        ],
                        "group": "test"
